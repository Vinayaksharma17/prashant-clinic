# Files to exclude from version control and deployment

# IDE and Editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Backup files
*.bak
*.backup
*.old

# Log files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Temporary files
*.tmp
.cache/
temp/
tmp/

# Environment files (if using any)
.env
.env.local
.env.production

# Node modules (if you add any build tools later)
node_modules/
package-lock.json
yarn.lock

# Build output (if using build tools)
dist/
build/

# Original images folder (since moved to ImageKit)
# Uncomment this line after confirming images are on ImageKit
# images/

# Testing and coverage
coverage/
.nyc_output/

# OS specific
Thumbs.db
Desktop.ini
